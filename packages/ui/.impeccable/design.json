    "typographyMeta": {
      "title": { "displayName": "Page Title", "purpose": "Compact current-page heading with tight tracking." },
      "dialog-title": { "displayName": "Dialog Title", "purpose": "Names a focused task without dominating its contents." },
      "section-title": { "displayName": "Section Title", "purpose": "Panels, table regions, and grouped settings." },
      "body": { "displayName": "Dense Body", "purpose": "Ordinary interface text and control content." },
      "body-reading": { "displayName": "Reading Body", "purpose": "Alerts, empty states, explanations, and sustained reading." },
      "control": { "displayName": "Control", "purpose": "Buttons, navigation rows, and selectable agent tiles." },
      "compact": { "displayName": "Compact Text", "purpose": "Segmented controls, activity text, and locally dense compositions." },
      "auxiliary": { "displayName": "Auxiliary", "purpose": "Metadata, supporting descriptions, timestamps, and secondary rows." },
      "label": { "displayName": "Form Label", "purpose": "Form labels and compact field guidance." },
      "caption": { "displayName": "Caption", "purpose": "Uppercase monospace table heads and workspace section headings." },
      "chip": { "displayName": "Chip", "purpose": "Tool-type identity and compact technical tags." },
      "status": { "displayName": "Status", "purpose": "Health badges and matrix cells with tabular numerals." },
      "code": { "displayName": "Code and Metadata", "purpose": "Paths, repository names, commands, and diagnostic metadata." },
      "metric": { "displayName": "Metric", "purpose": "KPI and health totals with tabular numerals." }
    },
