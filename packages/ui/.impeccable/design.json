  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Signal Blue action with a compact pressed state and themed disabled treatment.",
      "html": "<button class=\"ds-btn-primary\">Restore tools</button>",
      "css": ".ds-btn-primary{height:32px;padding:0 12px;border:0;border-radius:6px;background:var(--accent);color:#fff;font:500 13px var(--sans);display:inline-flex;align-items:center;justify-content:center;gap:6px;white-space:nowrap;cursor:pointer;transition:background-color 120ms var(--ease-out),color 120ms}.ds-btn-primary:hover:not(:disabled){background:var(--accent-h)}.ds-btn-primary:focus-visible{outline:2px solid var(--accent);outline-offset:2px}.ds-btn-primary:active:not(:disabled){transform:translateY(.5px)}.ds-btn-primary:disabled{background:var(--surface-3);color:var(--ink4);cursor:default}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Solid neutral action with a strong hairline and quiet hover surface.",
      "html": "<button class=\"ds-btn-secondary\">Sync repository</button>",
      "css": ".ds-btn-secondary{height:32px;padding:0 12px;border:1px solid var(--line2);border-radius:6px;background:var(--surface);color:var(--ink);font:500 13px var(--sans);display:inline-flex;align-items:center;justify-content:center;gap:6px;white-space:nowrap;cursor:pointer;transition:background-color 120ms var(--ease-out),border-color 120ms var(--ease-out),color 120ms}.ds-btn-secondary:hover:not(:disabled){background:var(--surface-2)}.ds-btn-secondary:focus-visible{outline:2px solid var(--accent);outline-offset:2px}.ds-btn-secondary:active:not(:disabled){transform:translateY(.5px)}.ds-btn-secondary:disabled{color:var(--ink3);cursor:default}"
    },
    {
      "name": "Text Input",
      "kind": "input",
      "refersTo": "input",
      "description": "Sunk editable field with accent border and soft focus ring.",
      "html": "<input class=\"ds-input\" aria-label=\"Search projects\" placeholder=\"Search projects\" />",
      "css": ".ds-input{height:32px;padding:0 10px;box-sizing:border-box;border:1px solid var(--line);border-radius:6px;background:var(--field);color:var(--ink);font:13px var(--sans);transition:border-color 120ms,box-shadow 120ms}.ds-input::placeholder{color:var(--ink4)}.ds-input:hover:not(:disabled){border-color:var(--line2)}.ds-input:focus{border-color:var(--accent);box-shadow:0 0 0 2px var(--accent-soft);outline:2px solid var(--accent);outline-offset:0}"
    },
    {
      "name": "Navigation Link",
      "kind": "nav",
      "refersTo": "navigation-link",
      "description": "Compact sidebar destination with tonal hover and active states, without an accent bar.",
      "html": "<a class=\"ds-nav-link ds-is-active\" href=\"#\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"14\" y=\"14\" width=\"7\" height=\"7\" rx=\"1\"/></svg>Overview</a>",
      "css": ".ds-nav-link{min-height:30px;padding:4px 10px;box-sizing:border-box;border-radius:6px;color:var(--ink2);background:transparent;font:13px var(--sans);text-decoration:none;display:flex;align-items:center;gap:9px;transition:background-color 120ms,color 120ms}.ds-nav-link svg{width:15px;height:15px;color:var(--ink3);flex-shrink:0}.ds-nav-link:hover{background:var(--surface-2);color:var(--ink)}.ds-nav-link:focus-visible{outline:2px solid var(--accent);outline-offset:2px}.ds-nav-link.ds-is-active{background:var(--surface-2);color:var(--ink);font-weight:500}.ds-nav-link.ds-is-active svg{color:var(--ink)}"
    },
    {
      "name": "Tool Type Chips",
      "kind": "chip",
      "refersTo": "chip",
      "description": "Non-interactive ghost labels with small semantic tool-type dots.",
      "html": "<span class=\"ds-chip ds-chip-skill\">Skill</span> <span class=\"ds-chip ds-chip-mcp\">MCP</span> <span class=\"ds-chip ds-chip-plugin\">Plugin</span>",
      "css": ".ds-chip{height:20px;padding:0 7px;box-sizing:border-box;border:1px solid var(--line2);border-radius:5px;background:transparent;color:var(--ink2);font:500 11px var(--mono);letter-spacing:.02em;display:inline-flex;align-items:center;gap:5px;white-space:nowrap}.ds-chip:before{content:\"\";width:6px;height:6px;border-radius:50%;flex-shrink:0}.ds-chip-skill:before{background:var(--skill)}.ds-chip-mcp:before{background:var(--mcp)}.ds-chip-plugin:before{background:var(--plugin)}"
    },
    {
      "name": "Status Badges",
      "kind": "chip",
      "refersTo": "status-error",
      "description": "Compact error and warning labels that pair semantic color with distinct glyphs.",
      "html": "<span class=\"ds-status ds-status-error\"><span class=\"ds-status-glyph\"></span>1 error</span> <span class=\"ds-status ds-status-warning\"><span class=\"ds-status-glyph\"></span>1 warning</span>",
      "css": ".ds-status{height:20px;padding:0 6px;box-sizing:border-box;border-radius:5px;font:500 11px var(--mono);font-variant-numeric:tabular-nums;display:inline-flex;align-items:center;gap:5px;white-space:nowrap}.ds-status-glyph{width:6px;height:6px;flex-shrink:0}.ds-status-error{background:var(--err-soft);color:var(--err-ink)}.ds-status-error .ds-status-glyph{border-radius:50%;background:var(--err)}.ds-status-warning{background:var(--warn-soft);color:var(--warn-ink)}.ds-status-warning .ds-status-glyph{border-radius:1px;background:var(--warn);transform:rotate(45deg)}"
    },
    {
      "name": "Stat Bar",
      "kind": "card",
      "refersTo": "card",
      "description": "One divided solid container with compact captions and tabular metrics.",
      "html": "<section class=\"ds-statbar\"><div class=\"ds-stat\"><span class=\"ds-stat-label\">Projects</span><strong class=\"ds-stat-value\">3</strong><span class=\"ds-stat-note\">1 directory missing</span></div><div class=\"ds-stat\"><span class=\"ds-stat-label\">Enabled tools</span><strong class=\"ds-stat-value\">7</strong><span class=\"ds-stat-note\">Across all projects</span></div></section>",
      "css": ".ds-statbar{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1px;overflow:hidden;border:1px solid var(--line);border-radius:8px;background:var(--line);color:var(--ink)}.ds-stat{padding:12px 16px;display:flex;flex-direction:column;align-items:flex-start;background:var(--surface)}.ds-stat-label{font:500 11px var(--sans);letter-spacing:.07em;text-transform:uppercase;color:var(--ink3)}.ds-stat-value{font:500 22px var(--mono);font-variant-numeric:tabular-nums}.ds-stat-note{font:12px var(--sans);color:var(--ink3)}"
    },
    {
      "name": "Matrix Cells",
      "kind": "custom",
      "refersTo": "matrix-cell",
      "description": "Dense project-tool toggles with distinct on, off, and pending-add states.",
      "html": "<div class=\"ds-matrix-set\"><button class=\"ds-matrix-cell ds-matrix-on\" aria-label=\"Enabled\">✓</button><button class=\"ds-matrix-cell ds-matrix-off\" aria-label=\"Disabled\"></button><button class=\"ds-matrix-cell ds-matrix-add\" aria-label=\"Pending addition\">+</button></div>",
      "css": ".ds-matrix-set{display:flex;align-items:center;gap:8px}.ds-matrix-cell{width:26px;height:26px;padding:0;box-sizing:border-box;border-radius:5px;font:500 11px var(--mono);display:inline-flex;align-items:center;justify-content:center;cursor:pointer;transition:transform 120ms var(--ease-out),background-color 160ms,border-color 160ms,color 160ms}.ds-matrix-on{border:0;background:var(--accent);color:#fff}.ds-matrix-off{border:1px solid var(--line2);background:transparent;color:var(--ink3)}.ds-matrix-add{border:1.5px dashed var(--accent);background:var(--accent-soft);color:var(--accent-ink)}.ds-matrix-cell:hover:not(:disabled){transform:scale(1.12)}.ds-matrix-cell:active:not(:disabled){transform:scale(.96)}.ds-matrix-cell:focus-visible{outline:2px solid var(--accent);outline-offset:2px}@media(prefers-reduced-motion:reduce){.ds-matrix-cell:hover:not(:disabled){transform:none}}"
    },
    {
      "name": "Simple Dialog",
      "kind": "custom",
      "refersTo": "dialog",
      "description": "Focused overlay task with divided header, readable body, and wrapped footer actions.",
      "html": "<section class=\"ds-dialog\" role=\"dialog\" aria-labelledby=\"ds-dialog-title\"><header class=\"ds-dialog-header\"><h2 class=\"ds-dialog-title\" id=\"ds-dialog-title\">Apply changes</h2><button class=\"ds-dialog-close\" aria-label=\"Close\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M18 6 6 18M6 6l12 12\"/></svg></button></header><div class=\"ds-dialog-body\">Review the generated configuration diff before writing to your projects.</div><footer class=\"ds-dialog-footer\"><button class=\"ds-dialog-cancel\">Cancel</button><button class=\"ds-dialog-apply\">Apply changes</button></footer></section>",
      "css": ".ds-dialog{width:min(560px,100%);overflow:hidden;border:1px solid var(--line2);border-radius:12px;background:var(--overlay);color:var(--ink);box-shadow:var(--shadow);animation:ds-dialog-pop 180ms var(--ease-out) backwards}.ds-dialog-header{padding:14px 16px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;gap:12px}.ds-dialog-title{margin:0;font:600 14px var(--sans)}.ds-dialog-close{width:32px;height:32px;padding:0;border:0;border-radius:6px;background:transparent;color:var(--ink2);display:inline-flex;align-items:center;justify-content:center;cursor:pointer}.ds-dialog-close:hover{background:var(--surface-2);color:var(--ink)}.ds-dialog-close svg{width:18px;height:18px}.ds-dialog-body{padding:14px 16px;color:var(--ink2);font:13px/1.6 var(--sans)}.ds-dialog-footer{padding:12px 16px;border-top:1px solid var(--line);display:flex;flex-wrap:wrap;justify-content:flex-end;gap:10px}.ds-dialog-footer button{height:32px;padding:0 12px;border-radius:6px;font:500 13px var(--sans);cursor:pointer}.ds-dialog-cancel{border:1px solid var(--line2);background:var(--surface);color:var(--ink)}.ds-dialog-cancel:hover{background:var(--surface-2)}.ds-dialog-apply{border:0;background:var(--accent);color:#fff}.ds-dialog-apply:hover{background:var(--accent-h)}.ds-dialog button:focus-visible{outline:2px solid var(--accent);outline-offset:2px}@keyframes ds-dialog-pop{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}@media(prefers-reduced-motion:reduce){.ds-dialog{animation:none}}"
    },
    {
      "name": "Success Toast",
      "kind": "custom",
      "refersTo": "toast",
      "description": "Transient confirmation with a status edge, concise detail, and accessible close action.",
      "html": "<section class=\"ds-toast\" role=\"status\"><span class=\"ds-toast-dot\"></span><div class=\"ds-toast-copy\"><strong class=\"ds-toast-title\">Repository synchronized</strong><span class=\"ds-toast-detail\">2 projects updated</span></div><button class=\"ds-toast-close\" aria-label=\"Dismiss\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M18 6 6 18M6 6l12 12\"/></svg></button></section>",
      "css": ".ds-toast{width:min(380px,calc(100vw - 32px));padding:12px 16px;box-sizing:border-box;border:1px solid var(--line2);border-left:3px solid var(--ok);border-radius:8px;background:var(--overlay);color:var(--ink);box-shadow:var(--shadow);display:flex;align-items:flex-start;gap:12px;animation:ds-toast-enter 180ms var(--ease-out) backwards}.ds-toast-dot{width:8px;height:8px;margin-top:6px;border-radius:50%;background:var(--ok);flex-shrink:0}.ds-toast-copy{display:flex;flex:1;flex-direction:column}.ds-toast-title{font:500 14px var(--sans)}.ds-toast-detail{font:12px/1.5 var(--sans);color:var(--ink3)}.ds-toast-close{width:28px;height:28px;padding:0;border:0;border-radius:6px;background:transparent;color:var(--ink3);display:inline-flex;align-items:center;justify-content:center;cursor:pointer}.ds-toast-close:hover{background:var(--surface-2);color:var(--ink)}.ds-toast-close:focus-visible{outline:2px solid var(--accent);outline-offset:2px}.ds-toast-close svg{width:14px;height:14px}@keyframes ds-toast-enter{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}@media(prefers-reduced-motion:reduce){.ds-toast{animation:none}}"
    }
  ],
  "narrative": {
    "northStar": "The Quiet Control Room",
    "overview": "The Quiet Control Room makes a dense local operations surface feel calm rather than compressed. Its voice is calm, precise, and restrained: solid neutral surfaces, hairline separators, compact controls, and state cues that can be scanned before they are read.\n\nSignal Blue directs attention only where the operator must act, focus, or inspect a selected state. Graphite Mist supplies the page ground, six surface levels, four ink levels, and borders in both themes. Tool-type and status colors remain small, semantic signals rather than decoration.\n\nComponents feel refined and restrained. Depth comes from tonal layering at rest and from shadows only on transient overlays. Motion is brief and direct. Decorative gradients, content-layer glass, illustration-led empty states, and floating cards are rejected; the gradient in the ATM logo is binding brand artwork, not a content-style exception.",
    "keyCharacteristics": [
      "Dense information architecture with low visual noise.",
      "Solid Graphite Mist surfaces and precise 1px separators.",
      "One action accent, with semantic color reserved for compact status and tool-type cues.",
      "Compact system typography, monospace metadata, and tabular numerals.",
      "Flat static surfaces, floating transient overlays, and short functional motion."
    ],
    "rules": [
      { "name": "The One Voice Rule", "body": "Signal Blue is the only general action accent. Tool-type colors stay on small identity cues, and status colors communicate state rather than decorating the interface.", "section": "colors" },
      { "name": "The Numeric Clarity Rule", "body": "Counts, token totals, health metrics, and changing numeric columns use monospace with tabular numerals so scanning and updates do not disturb alignment.", "section": "typography" },
      { "name": "The Flat-By-Default Rule", "body": "Never add a shadow to a static card, table, navigation row, or stat bar. Elevation appears only when a transient overlay temporarily sits above the workflow.", "section": "elevation" },
      { "name": "The Small-Radius Rule", "body": "Corners support dense grouping; they never turn panels into soft, oversized containers. Introduce a new radius only for a repeated component role.", "section": "shapes" }
    ],
    "dos": [
      "Do build hierarchy from semantic Graphite Mist surfaces, ink levels, and 1px separators.",
      "Do reserve Signal Blue for actions, focus, links, and selected/on states.",
      "Do use monospace and tabular numerals for paths, commands, metrics, and changing counts.",
      "Do preserve both semantic light and dark token variants in shared components.",
      "Do keep state transitions brief and direct, with reduced-motion alternatives for entrance and transform effects.",
      "Do keep empty states text-led and status signals paired with glyphs or labels.",
      "Do verify interface changes against the confirmed WCAG 2.2 AA product target."
    ],
    "donts": [
      "Don't use decorative gradients, content-layer glass, blur, or illustration-led empty states; the ATM logo gradient is brand artwork only.",
      "Don't add shadows to static cards, tables, stat bars, or navigation rows.",
      "Don't turn Skill Cyan, Plugin Violet, or status colors into general action accents or large background washes.",
      "Don't introduce a marketing display face, oversized hero typography, or staggered motion into the workbench.",
      "Don't treat prototype-only compact density, global ⌘K chrome, sticky Matrix headers, or sidebar accent bars as implemented behavior.",
      "Don't communicate health or tool type through color alone.",
      "Don't copy legacy Liquid Glass values, unused radius/motion slots, or one-off hard-coded colors into the normative system."
    ]
  }
}
