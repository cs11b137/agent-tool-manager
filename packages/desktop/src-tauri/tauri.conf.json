{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Tool Manager",
  "version": "0.3.0",
  "identifier": "dev.agent-tool-manager.desktop",
  "build": {
    "beforeDevCommand": "node scripts/prepare.mjs",
    "beforeBuildCommand": "node scripts/prepare.mjs",
    "frontendDist": "../launcher"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": [],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Manage project Skills, MCP servers and plugins",
    "resources": { "resources/": "resources/" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "14.0" }
  }
}
